{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/games/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/game/horof",
      "destination": "/hrof",
      "permanent": true
    },
    {
      "source": "/game/photos-2",
      "destination": "/thdi",
      "permanent": true
    },
    {
      "source": "/game/photos-3",
      "destination": "/thdi",
      "permanent": true
    },
    {
      "source": "/game/horof-bell",
      "destination": "/hrof",
      "permanent": true
    },
    {
      "source": "/game/photos-1",
      "destination": "/thdi",
      "permanent": true
    },
    {
      "source": "/game/family-feud",
      "destination": "/family",
      "permanent": true
    },
    {
      "source": "/game/fawazeer",
      "destination": "/fwzr",
      "permanent": true
    },
    {
      "source": "/game/guess-link",
      "destination": "/link",
      "permanent": true
    },
    {
      "source": "/game/alatrash",
      "destination": "/atrsh",
      "permanent": true
    },
    {
      "source": "/game/top-ten",
      "destination": "/top10",
      "permanent": true
    },
    {
      "source": "/game/mn-ana",
      "destination": "/mnana",
      "permanent": true
    }
  ]
}
